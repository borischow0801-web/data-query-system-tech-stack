# ========== 应用 ==========
# 应用名称（展示在 OpenAPI 标题等）
APP_NAME=数据查询系统
# 开发可 true；生产建议 false
DEBUG=true

# ========== MySQL ==========
# 统一连接串（Docker 内示例：mysql+pymysql://dq_user:密码@mysql:3306/data_query?charset=utf8mb4）
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/data_query?charset=utf8mb4

# ========== Redis（预留，当前业务代码未强制使用）==========
REDIS_URL=redis://localhost:6379/0

# ========== JWT（管理后台 /api/login）==========
# 生产务必替换为足够长的随机串
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== 导出文件存储 ==========
# 容器内需使用绝对路径并配合 volume 挂载
EXPORT_STORAGE_PATH=./storage/exports

# ========== 查询大报文 ==========
# 超过阈值则仅入库 preview，全文落盘到 QUERY_LOG_FILE_DIR
QUERY_LOG_INLINE_MAX_BYTES=65535
QUERY_LOG_FILE_DIR=./storage/query_payloads

# ========== 演示 / 联调开关 ==========
# true：不实际访问外部 HTTP、可使用 mock 加解密，便于空环境跑通
USE_MOCK_REMOTE=true
USE_MOCK_CRYPTO=true

# ========== Docker / Gunicorn（可选）==========
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
# 排障时跳过迁移（勿用于常规发布）：SKIP_ALEMBIC=1
