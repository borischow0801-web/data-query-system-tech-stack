# 复制到项目根目录并重命名为 .env 后由 docker compose 读取：
#   cp deploy/env.docker.example .env

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=please_change_root_password
MYSQL_DATABASE=data_query
MYSQL_USER=dq_user
MYSQL_PASSWORD=please_change_dq_password
MYSQL_PORT=3306

# ---------- 应用密钥（勿提交真实环境）----------
SECRET_KEY=please_use_long_random_string_for_jwt

# ---------- 可选：业务开关 ----------
DEBUG=false
USE_MOCK_REMOTE=true
USE_MOCK_CRYPTO=true
QUERY_LOG_INLINE_MAX_BYTES=65535

# ---------- Gunicorn ----------
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# ---------- 宿主机挂载目录（可改绝对路径）----------
HOST_LOG_DIR=./data/logs/backend
HOST_EXPORT_DIR=./data/exports
HOST_PAYLOAD_DIR=./data/query_payloads

# ---------- 对外 HTTP 端口（Nginx）----------
HTTP_PORT=8080

# ---------- Redis（预留）----------
REDIS_PORT=6379
